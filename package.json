{
  "name": "yuntuai-desktop",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/kill-dev-port.ps1",
    "dev": "vite",
    "pretauri": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-instances.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/strip-utf8-bom.ps1",
    "build": "tsc && vite build",
    "verify:frontend-chunks": "node scripts/verify-frontend-chunks.mjs",
    "verify:release-startup": "node scripts/verify-release-startup-invariants.mjs",
    "verify:release-boot": "node scripts/verify-release-boot.mjs",
    "verify:dialog-stability": "node scripts/verify-release-dialog-stability.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-release-desktop.ps1",
    "test": "vitest run",
    "test:app": "npm run typecheck && npm run test && npm run test:rust",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:frontend-chunks && npm run verify:release-startup && npm run verify:dialog-stability",
    "check:full": "npm run check && npm run clippy && npm run test:coverage",
    "test:components": "vitest run src/components",
    "test:integration": "vitest run src/lib/openclaw/gateway-send-integration.test.ts src/lib/openclaw/critical-paths.smoke.test.ts src/lib/openclaw/gateway-wake-probe.test.ts src/lib/openclaw/gateway-client.integration.test.ts src/stores/__tests__/session-send-gateway.test.ts src/stores/__tests__/session-send-outcome.test.ts src/stores/__tests__/session-send-retry.test.ts src/stores/session-subscription-orchestration.test.ts",
    "test:smoke": "vitest run src/lib/openclaw/critical-paths.smoke.test.ts src/lib/openclaw/gateway-wake-probe.test.ts src/stores/session-subscription-orchestration.test.ts",
    "test:round": "vitest run src/lib/product-copy.test.ts src/lib/chat/office-write-back.test.ts src/lib/chat/office-workbench.test.ts src/lib/openclaw/exec-package-guard.test.ts src/lib/openclaw/startup-toast-messages.test.ts src/lib/chat/assistant-message-display.test.ts src/lib/startup/startup-shell-phase.test.ts src/hooks/usePostLoginConnectGate.test.ts src/lib/connect-with-feedback.test.ts && node scripts/smoke-office-workbench.mjs",
    "test:pre-release": "npm run typecheck && npm test && npm run test:integration && npm run test:virtual && node scripts/smoke-office-workbench.mjs && npm run test:rust && npm run build && npm run verify:frontend-chunks && npm run verify:release-startup && npm run clippy",
    "test:virtual": "vitest run src/lib/openclaw/connect-orchestration.virtual.test.ts src/App.test.tsx src/components/chat/ChatPanel.test.tsx src/lib/connect-with-feedback.test.ts src/lib/openclaw/desktop-connect-scheduler.test.ts src/lib/openclaw/startup-connect-pipeline.test.ts src/hooks/useStartupConnectGate.test.ts src/hooks/useFirstRunGatewayGate.test.ts src/lib/startup/startup-shell-phase.test.ts src/components/openclaw/ServiceReadinessScreen.test.tsx",
    "release:selfcheck": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-selfcheck.ps1",
    "ci:desktop-smoke": "node scripts/ci-desktop-smoke.mjs",
    "lint": "eslint src",
    "test:coverage": "vitest run --coverage",
    "check:gateway": "node scripts/gateway-connect-probe.mjs",
    "factory:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-owner-secret.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-install-payload.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-upgrade-readiness.ps1 && node scripts/verify-release-startup-invariants.mjs && node scripts/full-desktop-check.mjs",
    "stress:gateway": "node scripts/stress-gateway-connection.mjs --rounds 3",
    "simulate:runtime": "node scripts/simulate-full-runtime.mjs --rounds 2",
    "simulate:runtime:chat": "node scripts/simulate-full-runtime.mjs --rounds 1 --with-chat",
    "trial:chat": "node scripts/user-trial-chat.mjs",
    "trial:chat:multi": "node scripts/multi-round-chat-probe.mjs --rounds 5",
    "trial:desktop": "node scripts/desktop-chat-trial.mjs",
    "trial:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-desktop-trial.ps1",
    "sync:env": "node scripts/sync-yuntuai-env.mjs",
    "dev:internal": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-distribution.ps1 -Profile internal",
    "dev:deepseek": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-distribution.ps1 -Profile internal",
    "dev:relay": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-distribution.ps1 -Profile relay-station",
    "pkg:release:internal": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/make-release-bundle.ps1 -DistributionProfile internal",
    "pkg:release:deepseek": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/make-release-bundle.ps1 -DistributionProfile internal",
    "pkg:release:1310-indigo": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/make-release-1310-indigo.ps1",
    "pkg:release:relay": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/make-release-bundle.ps1 -DistributionProfile relay-station",
    "relay:probe": "node ./scripts/relay-api-probe.mjs",
    "relay:probe:pack": "node ./scripts/relay-api-probe.mjs --pack",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:installer-assets": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-installer-assets.ps1",
    "prepare:openclaw": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-openclaw-portable.ps1",
    "prepare:openclaw:macos": "bash ./scripts/prepare-openclaw-portable-macos.sh",
    "prepare:openclaw:force": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-openclaw-portable.ps1 -Force",
    "prepare:community-skills": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-community-skills.ps1",
    "stage:support": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stage-install-support.ps1",
    "verify:install-payload": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-install-payload.ps1",
    "verify:owner": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-owner-secret.ps1",
    "verify:upgrade-readiness": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-upgrade-readiness.ps1",
    "verify:release-manifest": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-release-manifest.ps1",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/create-desktop-shortcut.ps1",
    "shortcut:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/create-desktop-shortcut.ps1 -Dev",
    "sse-bridge": "npm run start --prefix packages/sse-bridge",
    "sse-bridge:gencert": "npm run gencert --prefix packages/sse-bridge",
    "monitor:dev": "npm run dev --prefix monitor-mobile",
    "monitor:tauri": "npm run tauri --prefix monitor-mobile",
    "pkg:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/make-release-bundle.ps1",
    "pkg:release:macos": "bash ./scripts/make-release-bundle-macos.sh",
    "pkg:release:macos:internal": "bash ./scripts/make-release-bundle-macos.sh --distribution-profile internal",
    "pkg:release:macos:deepseek": "bash ./scripts/make-release-bundle-macos.sh --distribution-profile internal",
    "pkg:release:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/make-release-bundle.ps1 -IncludePortableNode",
    "pkg:enduser": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/make-release-bundle.ps1",
    "upgrade:inplace": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/upgrade-inplace.ps1",
    "dogfood:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dogfood-status.ps1",
    "dogfood:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dogfood-bootstrap.ps1",
    "dogfood:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dogfood-sync.ps1 -Launch",
    "dogfood:launch": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dogfood-launch.ps1",
    "publish:latest": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish-latest.ps1"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "gsap": "^3.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.4"
  }
}
